# Copy to .env.production (git-ignored) and fill in every empty value before deploying.
# Never commit real secrets. Generate SECRET_KEY with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
BASE_HOST=next-django-template.test
PROD=True

# PostgreSQL Config

DATABASE_URL=sqlite:///backend/db.sqlite3
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Email

SENDGRID_USERNAME=
SENDGRID_PASSWORD=

# Django Config Variables

PYTHONUNBUFFERED=True
DJANGO_DEBUG=False
ALLOWED_HOSTS=api.next-django-template.test
SECRET_KEY=
DEFAULT_USER=guest
DEFAULT_PASS=guest

# superuser default (`make superuser`)
DJANGO_SUPERUSER_USERNAME=superadmin
DJANGO_SUPERUSER_EMAIL=admin@admin.com
DJANGO_SUPERUSER_PASSWORD=
